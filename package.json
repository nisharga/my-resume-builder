  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "doctor": "npx expo-doctor@latest",
    "prepare": "husky",
    "build:preview": "node scripts/release.js build preview",
    "build:prod": "node scripts/release.js build production",
    "ota:preview": "node scripts/release.js ota preview",
    "ota:prod": "node scripts/release.js ota production"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/src/__mocks__/styleMock.js",
      "^@/(.*)$": "<rootDir>/$1",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock.js",
      "react-native-reanimated": "<rootDir>/src/__mocks__/react-native-reanimated.js",
      "lucide-react-native": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "expo-notifications": "<rootDir>/src/__mocks__/expo-notifications.js",
      "expo-router": "<rootDir>/src/__mocks__/expo-router.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|nativewind|react-native-css|@gluestack-ui/.*|lucide-react-native|standard-navigation|@legendapp|immer)"
    ]
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
