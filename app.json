{
  "expo": {
    "name": "Resume Builder",
    "slug": "my-resume-builder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myresumebuilder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nisharga.myresumebuilder"
    },
    "android": {
      "package": "com.nisharga.myresumebuilder",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softInputMode": "adjustResize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter/Inter-Regular.ttf",
            "./assets/fonts/Inter/Inter-Medium.ttf",
            "./assets/fonts/Inter/Inter-SemiBold.ttf",
            "./assets/fonts/Inter/Inter-Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#4a6cf7",
          "sounds": ["./assets/sounds/notification_sound.wav"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "bruskee",
          "project": "my-resume-builder"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68e2eb51-6599-4f38-8eb1-362644a28008"
      }
    },
    "owner": "nisharga.sharetasking",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/68e2eb51-6599-4f38-8eb1-362644a28008"
    }
  }
}
