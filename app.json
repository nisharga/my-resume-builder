{
  "expo": {
    "name": "Resume Builder",
    "slug": "my-resume-builder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myresumebuilder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nisharga.myresumebuilder"
    },
    "android": {
      "package": "com.nisharga.myresumebuilder",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softInputMode": "adjustResize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter/Inter-Regular.ttf",
            "./assets/fonts/Inter/Inter-Medium.ttf",
            "./assets/fonts/Inter/Inter-SemiBold.ttf",
            "./assets/fonts/Inter/Inter-Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#4a6cf7",
          "sounds": ["./assets/sounds/notification_sound.wav", "./assets/sounds/guiter.wav"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "nisharga-sharetasking",
          "project": "resume-builder"
        }
      ],
      "expo-sharing",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a741c77-9736-4a30-a912-f1977ab4755c"
      }
    },
    "owner": "nisharga.sharetasking"
  }
}
